          }
        }
      }
    },
    "Sem GPS: trechos por distância viram tempo pelo seu ritmo-alvo, e a distância total você digita no fim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without GPS: distance steps become time at your target pace, and you type the total distance at the end."
          }
        }
      }
    },
    "Sem permissão de Bluetooth. Ligue em Ajustes do iPhone > Apps > CRUNNING.": {
