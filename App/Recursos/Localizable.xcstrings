      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance of recorded runs, Monday to Sunday (no simulations). Planned is the plan's training volume, without the race. Big jumps from one week to the next deserve attention: the plan caps it at 10% by default."
          }
        }
      }
    },
