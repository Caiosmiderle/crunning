{
  "sourceLanguage": "pt-BR",
  "strings": {
    "%@ em %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@"
          }
        }
      }
    },
    "%@, cerca de %lld min, fora do tempo do treino. É sugestão: faça antes de deslizar para começar. Toque num exercício para ver como fazer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, about %2$lld min, outside the workout time. It's a suggestion: do it before you swipe to start. Tap an exercise to see how to do it."
          }
        }
      }
    },
    "%@, ritmo %@ por %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pace %2$@ per %3$@"
          }
        }
      }
    },
    "%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %2$@"
          }
        }
      }
    },
    "%lld bpm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bpm"
          }
        }
      }
    },
