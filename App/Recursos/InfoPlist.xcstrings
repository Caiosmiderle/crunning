{
  "sourceLanguage": "pt-BR",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRUNNING reads the heart rate your band sends over Bluetooth to show it during your run, even with the screen locked. It connects to the band only for that."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CRUNNING lê os batimentos que a sua pulseira envia por Bluetooth para mostrar na corrida, inclusive com a tela bloqueada. Ele se conecta à pulseira só para isso."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRUNNING puts your plan's workouts in its own calendar (\"CRUNNING\") and keeps it up to date when the plan changes. It only touches that calendar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CRUNNING coloca os treinos do seu plano num calendário próprio (\"CRUNNING\") e o mantém atualizado quando o plano muda. Ele só mexe nesse calendário."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRUNNING uses your location to measure the distance, pace and route of your runs, even with the screen locked. The route stays on your iPhone unless you send the run to Strava."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CRUNNING usa a localização para medir a distância, o ritmo e o trajeto das suas corridas, inclusive com a tela bloqueada. A rota fica no seu iPhone, a não ser que você envie a corrida ao Strava."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRUNNING uses your location to measure the distance, pace and route of your runs, even with the screen locked. The route stays on your iPhone unless you send the run to Strava."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CRUNNING usa a localização para medir a distância, o ritmo e o trajeto das suas corridas, inclusive com a tela bloqueada. A rota fica no seu iPhone, a não ser que você envie a corrida ao Strava."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRUNNING saves to your Photos the run image you chose to share. It doesn't read your photos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CRUNNING salva nas suas Fotos a imagem da corrida que você escolheu compartilhar. Ele não lê as suas fotos."
          }
        }
      }
    }
  },
  "version": "1.0"
}
